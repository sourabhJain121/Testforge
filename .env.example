# ==============================================================================
# TestForge: Master Environment Configuration Template (.env.example)
# Production & Cloud Deployment Configuration (Azure, Render, Cloud Run, Local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Cloud LLM Provider: TokenHarbor (DeepSeek Free Model)
# ------------------------------------------------------------------------------
# TokenHarbor API Key for cloud test synthesis and reflection
TOKEN_HARBOR_API_KEY=

# TokenHarbor Base URL (OpenAI-compatible endpoint)
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1

# TokenHarbor DeepSeek Free Model Identifier
TOKEN_HARBOR_MODEL=deepseek-v4.1-flash:free

# ------------------------------------------------------------------------------
# 2. Local Engine: Offline Ollama (Zero Cost Mode)
# ------------------------------------------------------------------------------
# Local Ollama daemon URL for zero-cost offline synthesis (default: codellama:7b)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local Ollama model identifier (default: codellama:7b)
OLLAMA_MODEL=codellama:7b

# Provider routing mode ("auto" | "tokenharbor" | "ollama_only")
# When TOKEN_HARBOR_API_KEY is present -> routes to TokenHarbor deepseek-v4.1-flash:free
# When TOKEN_HARBOR_API_KEY is unset -> automatically routes to local Ollama codellama:7b
TESTFORGE_PROVIDER_MODE=auto

# Force live cloud LLM execution in evaluation scripts (0=offline/mock, 1=live cloud)
TESTFORGE_LIVE_LLM=1

# Zero-Egress Air-Gapped Privacy Mode (true = blocks external sockets, scrubs PII)
TESTFORGE_PRIVACY_MODE=false

# ------------------------------------------------------------------------------
# 3. Multi-Agent Systems Runtime & Telemetry (CrewAI & OpenTelemetry)
# ------------------------------------------------------------------------------
CREWAI_TESTING=true
CREWAI_TRACING_ENABLED=false
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
OTEL_PYTHON_CONTEXT=contextvars_context

# ------------------------------------------------------------------------------
# 4. Sandbox Execution & Parallel CPU Workers
# ------------------------------------------------------------------------------
SANDBOX_TIMEOUT_SEC=15
TESTFORGE_SANDBOX_WORKERS=4

# ------------------------------------------------------------------------------
# 5. State Persistence & Knowledge Base (RAG)
# ------------------------------------------------------------------------------
TESTFORGE_CHECKPOINT_DB=qa_artifacts/testforge_checkpoints.db
TESTFORGE_KB_DIR=testforge/rag/knowledge_base

# ------------------------------------------------------------------------------
# 6. Server Network & Cloud Deployment Binding
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# 7. Optional Third-Party Integrations
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_token_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
