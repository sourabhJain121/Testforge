# ==============================================================================
# TestForge: Master Environment Configuration Template (.env.example)
# Production & Cloud Deployment Configuration (Cloud Run, Render, Local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Foundation LLM Cloud Providers (Google ADK & OpenRouter Failover)
# ------------------------------------------------------------------------------
# Primary Google Gemini API key for Tier 1 cloud test synthesis & reflection
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary Google Gemini API key (auto-rotated on 429 quota exhaustion)
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# Alias for secondary Gemini API key failover
GEMINI_FALLBACK_API_KEY=your_secondary_gemini_api_key_here

# Google Cloud SDK / ADK standard fallback key (optional)
GOOGLE_API_KEY=your_google_cloud_api_key_here

# OpenRouter Cloud API key for Tier 2 multi-model cloud fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default foundation model identifier (default: gemini-3.6-flash)
TESTFORGE_MODEL=gemini-3.6-flash

# Force live cloud LLM execution in evaluation scripts (0=offline/mock, 1=live cloud)
TESTFORGE_LIVE_LLM=0

# ------------------------------------------------------------------------------
# 2. Local Engine & Air-Gapped Privacy Configuration
# ------------------------------------------------------------------------------
# Local Ollama daemon URL for Tier 3 offline synthesis (qwen2.5-coder:7b)
OLLAMA_BASE_URL=http://localhost:11434

# Zero-Egress Air-Gapped Privacy Mode (true = blocks external sockets, scrubs PII)
TESTFORGE_PRIVACY_MODE=false

# ------------------------------------------------------------------------------
# 3. Multi-Agent Systems Runtime & Telemetry (CrewAI & OpenTelemetry)
# ------------------------------------------------------------------------------
# Disables CrewAI interactive telemetry prompts in headless environments
CREWAI_TESTING=true

# Disables external tracing in CI/test environments
CREWAI_TRACING_ENABLED=false

# Opt-out of third-party telemetry collection
CREWAI_TELEMETRY_OPT_OUT=true

# Suppresses OpenTelemetry context detachment crashes in async worker loops
OTEL_SDK_DISABLED=true
OTEL_PYTHON_CONTEXT=contextvars_context

# ------------------------------------------------------------------------------
# 4. Sandbox Execution & Parallel CPU Workers
# ------------------------------------------------------------------------------
# Execution timeout per mutant test evaluation batch in seconds (default: 15)
SANDBOX_TIMEOUT_SEC=15

# Number of parallel subprocess worker processes (default: 4, or auto-detected CPU cores)
TESTFORGE_SANDBOX_WORKERS=4

# ------------------------------------------------------------------------------
# 5. State Persistence & Knowledge Base (RAG)
# ------------------------------------------------------------------------------
# SQLite transactional checkpoint database path for point-in-time state recovery
TESTFORGE_CHECKPOINT_DB=qa_artifacts/testforge_checkpoints.db

# Path to testing patterns knowledge base directory for live agentic RAG
TESTFORGE_KB_DIR=testforge/rag/knowledge_base

# ------------------------------------------------------------------------------
# 6. Server Network & Cloud Deployment Binding
# ------------------------------------------------------------------------------
# Dynamic port allocated by Cloud Run, Render, or Docker (default: 8000)
PORT=8000

# Server host interface binding (0.0.0.0 for containers, 127.0.0.1 for local)
HOST=0.0.0.0

# Unbuffered stdout/stderr streaming for real-time cloud container logs
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# 7. Optional Third-Party Integrations
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) for higher rate-limit repository AST ingestion
GITHUB_TOKEN=your_github_token_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
